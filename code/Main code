def validate_integer_subsource_diameter(value):
    value = float(value)
    if not np.isfinite(value):
        raise ValueError(f"Invalid subsource diameter: {value}")
    rounded = int(round(value))
    if not np.isclose(value, rounded, rtol=0.0, atol=DIAMETER_MATCH_ATOL):
        raise ValueError(f"Subsource diameter {value:g} mm is not an integer")
    if not (MIN_SUBSOURCE_DIAMETER_MM <= rounded <= MAX_SUBSOURCE_DIAMETER_MM):
        raise ValueError(
            f"Unsupported subsource diameter {rounded} mm; expected "
            f"{MIN_SUBSOURCE_DIAMETER_MM}-{MAX_SUBSOURCE_DIAMETER_MM} mm"
        )
    return rounded


def normalize_subsource_record(record):
    """Normalize geometry plus optional observed event statistics."""
    if isinstance(record, dict):
        out = {
            "subsource_id": int(record["subsource_id"]),
            "subsource_center_x": float(record["subsource_center_x"]),
            "subsource_center_y": float(record["subsource_center_y"]),
            "subsource_center_z": float(record["subsource_center_z"]),
            "subsource_diameter": float(record["subsource_diameter"]),
        }
        if "event_count" in record:
            out["event_count"] = int(record["event_count"])
        if "event_fraction" in record:
            out["event_fraction"] = float(record["event_fraction"])
        return out

    values = list(record)
    if len(values) not in (5, 7):
        raise ValueError(f"Unsupported subsource record: {record}")
    sid, cx, cy, cz, diameter = values[:5]
    out = {
        "subsource_id": int(sid),
        "subsource_center_x": float(cx),
        "subsource_center_y": float(cy),
        "subsource_center_z": float(cz),
        "subsource_diameter": float(diameter),
    }
    if len(values) == 7:
        out["event_count"] = int(values[5])
        out["event_fraction"] = float(values[6])
    return out


def normalize_source_record(record):
    if not isinstance(record, dict):
        raise ValueError("A multi-subsource source record must be a dictionary")
    subs = [normalize_subsource_record(x) for x in record.get("subsources", [])]
    subs = sorted(subs, key=lambda x: x["subsource_id"])
    declared = int(record.get("number_of_subsources", len(subs)))
    if declared != len(subs):
        raise ValueError(
            f"source_id={record.get('source_id')} declares {declared} subsources "
            f"but record contains {len(subs)}"
        )

    # If event statistics are present, validate and renormalize tiny floating
    # point drift. These values are TARGET METADATA only; they are never neural
    # network input features.
    if subs and all("event_fraction" in s for s in subs):
        fractions = np.asarray([s["event_fraction"] for s in subs], dtype=np.float64)
        if np.any(~np.isfinite(fractions)) or np.any(fractions < 0.0):
            raise ValueError("Invalid subsource event_fraction values")
        total = float(fractions.sum())
        if total <= 0.0:
            raise ValueError("Subsource event fractions have zero total mass")
        fractions /= total
        for s, w in zip(subs, fractions):
            s["event_fraction"] = float(w)

    return {
        "source_id": int(record["source_id"]),
        "number_of_subsources": declared,
        "subsources": subs,
    }


def source_record_to_json(record):
    return normalize_source_record(record)


def source_record_centres(record):
    r = normalize_source_record(record)
    return np.asarray([
        [s["subsource_center_x"], s["subsource_center_y"], s["subsource_center_z"]]
        for s in r["subsources"]
    ], dtype=np.float32)


def source_record_diameters(record):
    r = normalize_source_record(record)
    return np.asarray([s["subsource_diameter"] for s in r["subsources"]], dtype=np.float32)


def source_record_event_fractions(record):
    """Return observed per-subsource event fractions from the record.

    New training records always contain these fractions. Equal weighting is
    used only as a backward-compatible fallback for legacy records that lack
    event-count metadata; it is never used to classify a dataset criterion.
    """
    r = normalize_source_record(record)
    n = r["number_of_subsources"]
    if n <= 0:
        raise ValueError("number_of_subsources must be positive")

    if all("event_fraction" in s for s in r["subsources"]):
        weights = np.asarray([s["event_fraction"] for s in r["subsources"]], dtype=np.float64)
    elif all("event_count" in s for s in r["subsources"]):
        weights = np.asarray([s["event_count"] for s in r["subsources"]], dtype=np.float64)
    else:
        weights = np.ones(n, dtype=np.float64)

    if np.any(~np.isfinite(weights)) or np.any(weights < 0.0):
        raise ValueError("Invalid subsource target weights")
    total = float(weights.sum())
    if total <= 0.0:
        raise ValueError("Subsource target weights have zero total mass")
    return (weights / total).astype(np.float32)


def true_event_cloud_centroid(source_points_xyz):
    """Centroid of the actual simulated emission-event cloud.

    This is criterion-agnostic. A 50/50 source distribution naturally gives an
    equal contribution; any other distribution naturally shifts the centroid
    according to the rows actually present in the data.
    """
    points = np.asarray(source_points_xyz, dtype=np.float64)
    if points.ndim != 2 or points.shape[1] != 3 or points.shape[0] == 0:
        raise ValueError("source_points_xyz must have shape (N, 3) with N > 0")
    if not np.all(np.isfinite(points)):
        raise ValueError("source_points_xyz contains non-finite values")
    return points.mean(axis=0).astype(np.float64)


def build_source_record_from_group(g):
    """Build source geometry and observed event fractions directly from CSV rows."""
    first = g.iloc[0]
    source_id = int(first["source_id"])
    declared = int(first["number_of_subsources"])
    total_events = int(len(g))
    if total_events <= 0:
        raise ValueError(f"source_id={source_id} has no event rows")

    sub_table = (
        g[[
            "subsource_id",
            "subsource_center_x",
            "subsource_center_y",
            "subsource_center_z",
            "subsource_diameter",
        ]]
        .drop_duplicates(subset=["subsource_id"])
        .sort_values("subsource_id", kind="mergesort")
    )

    counts = g.groupby("subsource_id", sort=True).size().to_dict()
    subs = []
    for row in sub_table.itertuples(index=False):
        sid = int(row.subsource_id)
        event_count = int(counts.get(sid, 0))
        if event_count <= 0:
            raise ValueError(
                f"source_id={source_id}, subsource_id={sid} has no event rows"
            )
        subs.append({
            "subsource_id": sid,
            "subsource_center_x": float(row.subsource_center_x),
            "subsource_center_y": float(row.subsource_center_y),
            "subsource_center_z": float(row.subsource_center_z),
            "subsource_diameter": float(row.subsource_diameter),
            "event_count": event_count,
            "event_fraction": float(event_count / total_events),
        })

    return normalize_source_record({
        "source_id": source_id,
        "number_of_subsources": declared,
        "subsources": subs,
    })


def update_source_record_event_weights(record, selected_subsource_ids):
    """Update target weights to match the event rows actually fed to the model."""
    record = normalize_source_record(record)
    ids = np.asarray(selected_subsource_ids, dtype=np.int64).reshape(-1)
    if ids.size == 0:
        raise ValueError("Cannot update event weights from an empty event selection")

    total = int(ids.size)
    new_subs = []
    for sub in record["subsources"]:
        sid = int(sub["subsource_id"])
        count = int(np.sum(ids == sid))
        new_sub = dict(sub)
        new_sub["event_count"] = count
        new_sub["event_fraction"] = float(count / total)
        new_subs.append(new_sub)

    if sum(s["event_count"] for s in new_subs) != total:
        raise RuntimeError("Selected subsource event counts do not sum to selected events")

    return normalize_source_record({
        "source_id": record["source_id"],
        "number_of_subsources": record["number_of_subsources"],
        "subsources": new_subs,
    })


def summarize_subsource_counts(source_records, split_name, warn_threshold=None):
    counts = {}
    for record in source_records:
        n = normalize_source_record(record)["number_of_subsources"]
        counts[n] = counts.get(n, 0) + 1
    print(f"\nOverall-source counts by number of subsources for {split_name}:")
    for n in sorted(counts):
        print(f"  {n} subsources: {counts[n]} overall sources")
    if warn_threshold is not None:
        low = {n: c for n, c in counts.items() if c < int(warn_threshold)}
        if low:
            print(f"  NOTE: small training groups: {low}")
    return counts


def choose_safe_count_stratify(labels, test_size, split_name):
    labels = np.asarray(labels, dtype=np.int32)
    unique_labels, counts = np.unique(labels, return_counts=True)
    if len(unique_labels) <= 1:
        return None
    n_samples = len(labels)
    n_test = int(np.ceil(float(test_size) * n_samples)) if isinstance(test_size, float) else int(test_size)
    n_train = n_samples - n_test
    possible = np.min(counts) >= 2 and n_test >= len(unique_labels) and n_train >= len(unique_labels)
    if possible:
        return labels
    print(
        f"Note: subsource-count stratification is not possible for {split_name}; "
        "using deterministic shuffled splitting instead."
    )
    return None


def select_uniform_random_events(
    X,
    source_points,
    subsource_ids,
    rng,
    min_events=None,
    max_events=None,
):
    """Select detector rows and preserve their subsource bookkeeping.

    The subsource IDs are used only to construct the supervised target after
    selection. They are never appended to the neural-network input features.
    """
    min_events, max_events = validate_random_event_range(min_events, max_events)
    X = np.asarray(X, dtype=np.float32)
    source_points = np.asarray(source_points, dtype=np.float32)
    subsource_ids = np.asarray(subsource_ids, dtype=np.int64).reshape(-1)

    if X.shape[0] != source_points.shape[0] or X.shape[0] != subsource_ids.shape[0]:
        raise ValueError("Detector rows, source-point rows, and subsource IDs must have equal length")

    n_available = int(X.shape[0])
    if n_available < min_events:
        return None, None, None, None

    upper = min(max_events, n_available)
    selected_count = int(rng.integers(min_events, upper + 1))

    if selected_count == n_available:
        idx = np.arange(n_available, dtype=np.int64)
    else:
        # Prefer a subset that still contains every subsource represented in
        # the available rows. This keeps the physical multi-source target and
        # selected detector population consistent.
        available_ids = np.unique(subsource_ids)
        idx = None
        if selected_count >= available_ids.size:
            for _ in range(200):
                candidate = np.sort(rng.choice(n_available, size=selected_count, replace=False))
                if np.unique(subsource_ids[candidate]).size == available_ids.size:
                    idx = candidate
                    break
        if idx is None:
            idx = np.sort(rng.choice(n_available, size=selected_count, replace=False))

    return (
        X[idx].astype(np.float32),
        source_points[idx].astype(np.float32),
        subsource_ids[idx].astype(np.int64),
        selected_count,
    )


def sample_variable_split(
    raw_inputs,
    raw_source_points,
    raw_subsource_ids,
    source_records,
    split_name,
    rng,
    min_events=None,
    max_events=None,
):
    min_events, max_events = validate_random_event_range(min_events, max_events)
    selected_inputs = []
    selected_points = []
    selected_records = []
    manifest_rows = []
    skipped = []

    for X, points, sub_ids, record in zip(
        raw_inputs, raw_source_points, raw_subsource_ids, source_records
    ):
        record = normalize_source_record(record)
        selected_X, selected_p, selected_ids, selected_count = select_uniform_random_events(
            X,
            points,
            sub_ids,
            rng,
            min_events=min_events,
            max_events=max_events,
        )
        if selected_X is None:
            skipped.append((record["source_id"], int(X.shape[0])))
            continue

        selected_record = update_source_record_event_weights(record, selected_ids)
        selected_inputs.append(selected_X)
        selected_points.append(selected_p)
        selected_records.append(selected_record)

        weights = source_record_event_fractions(selected_record)
        manifest_row = {
            "source_id": int(record["source_id"]),
            "number_of_subsources": int(record["number_of_subsources"]),
            "dataset_split": str(split_name),
            "available_events": int(X.shape[0]),
            "selected_events": int(selected_count),
            "padded_sequence_length": int(max_events),
            "target_representation": "observed_event_fraction_weighted_physical_subspheres",
            "gaussian_sigma": float(TARGET_SPHERE_SIGMA),
        }
        for sid, weight in enumerate(weights):
            manifest_row[f"subsource_{sid}_event_fraction"] = float(weight)
        manifest_rows.append(manifest_row)

    print(f"\nEvent selection for {split_name}:")
    print(f"  Sources kept: {len(selected_records)}")
    print(f"  Sources dropped (<{min_events} events): {len(skipped)}")
    return selected_inputs, selected_points, selected_records, manifest_rows


