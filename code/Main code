    scaler,
    train_records,
    val_records,
    test_records,
    feature_cols,
    sequence_pad_length,
    coord_ranges=None,
):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coord_ranges = normalize_coord_ranges(coord_ranges)
    joblib.dump(scaler, TRAIN_SCALER_PATH)

    train_json = [source_record_to_json(x) for x in train_records]
    val_json = [source_record_to_json(x) for x in val_records]
    test_json = [source_record_to_json(x) for x in test_records]

    # Explicitly verify zero source overlap.
    train_ids = {x["source_id"] for x in train_json}
    val_ids = {x["source_id"] for x in val_json}
    test_ids = {x["source_id"] for x in test_json}
