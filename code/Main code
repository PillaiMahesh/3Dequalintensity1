        f.write("\nComponent-centre extraction note: the true number of subsources is used only during evaluation to request the same number of KMeans component centres from probability-weighted samples of the raw prediction; it is not an input to the network. Observed subsource event fractions are used only to build supervised ground-truth targets and are also not model inputs.\n")

    print("Saved source-count performance:", source_stats_path)
    print("Saved diameter performance:", diameter_path)
    print("Saved summary figure:", fig_path)
