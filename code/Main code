def _hist_moments_with_edges(data, edges):
    counts, _ = np.histogram(data, bins=edges)
    centers = 0.5 * (edges[:-1] + edges[1:])
    total = counts.sum()
    if total == 0:
        return {"mean": 0.0, "var": 0.0, "std": 0.0, "edges": edges}
    probs = counts / total
    mean = float(np.sum(probs * centers))
    var = float(np.sum(probs * (centers - mean) ** 2))
    return {"mean": mean, "var": var, "std": float(np.sqrt(var)), "edges": edges}


def plot_hist_with_moments(data, title_base, xlabel, out_path, bins=30):
    edges = np.histogram_bin_edges(data, bins=bins)
    stats = _hist_moments_with_edges(data, edges)
    plt.figure(figsize=(12, 6))
    plt.hist(data, bins=edges, edgecolor="black", linewidth=1.0)
    plt.xlabel(xlabel)
    plt.ylabel("Samples")
    plt.axvline(stats["mean"], linestyle="--", linewidth=2)
    plt.title(f"{title_base}\nμ={stats['mean']:.3f}, σ²={stats['var']:.3f}, σ={stats['std']:.3f}")
    plt.tight_layout()
    plt.savefig(out_path, dpi=150)
    plt.close()
    return stats


def _sum_projections(volume_zyx):
    volume_zyx = np.asarray(volume_zyx, dtype=np.float32)
    return (
        np.sum(volume_zyx, axis=0),
        np.sum(volume_zyx, axis=1),
        np.sum(volume_zyx, axis=2),
    )


def _normalize_panel(image):
    image = np.asarray(image, dtype=np.float32)
    m = float(np.max(image)) if image.size else 0.0
    return image / m if m > 0 else image


def probability_center_of_mass(volume_zyx, bins=50, coord_ranges=None):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    volume = np.asarray(volume_zyx, dtype=np.float64)
    total = float(volume.sum())
    if not np.isfinite(total) or total <= 0:
        iz, iy, ix = np.unravel_index(np.argmax(volume), volume.shape)
        return idx_to_coord(ix, iy, iz, bins=bins, coord_ranges=coord_ranges)
    zidx = np.arange(volume.shape[0], dtype=np.float64)[:, None, None]
    yidx = np.arange(volume.shape[1], dtype=np.float64)[None, :, None]
    xidx = np.arange(volume.shape[2], dtype=np.float64)[None, None, :]
    iz = float(np.sum(volume * zidx) / total)
    iy = float(np.sum(volume * yidx) / total)
    ix = float(np.sum(volume * xidx) / total)
    return (
        idx_to_coord_axis(ix, "x", bins, coord_ranges),
        idx_to_coord_axis(iy, "y", bins, coord_ranges),
        idx_to_coord_axis(iz, "z", bins, coord_ranges),
    )


