# =========================================================
# 3D TARGETS: DATA-DRIVEN EVENT-FRACTION MIXTURE OF PHYSICAL SUBSPHERES
# =========================================================
def make_physical_sphere_volume(
    center_xyz,
    sphere_diameter,
    bins=50,
    sigma=0.0,
    normalize="sum",
    coord_ranges=None,
):
    """Construct one physical sphere efficiently on the [Z,Y,X] grid.

    Only a local box around the sphere is evaluated. For sigma>0 the box is
    enlarged by the Gaussian kernel support, which makes this substantially
    faster for 2-20 mm subsources than rebuilding a full 50^3 distance field
    for every component.
    """
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coord_ranges = normalize_coord_ranges(coord_ranges)
    center = np.asarray(center_xyz, dtype=np.float64).reshape(-1)
    if center.size != 3 or not np.all(np.isfinite(center)):
        raise ValueError("center_xyz must contain three finite coordinates")
    diameter = float(validate_integer_subsource_diameter(sphere_diameter))
    radius = diameter / 2.0
    sigma = float(sigma)
    if sigma < 0:
        raise ValueError("sigma cannot be negative")

    x_values = np.linspace(coord_ranges["x"][0], coord_ranges["x"][1], bins, dtype=np.float64)
    y_values = np.linspace(coord_ranges["y"][0], coord_ranges["y"][1], bins, dtype=np.float64)
    z_values = np.linspace(coord_ranges["z"][0], coord_ranges["z"][1], bins, dtype=np.float64)

    # gaussian_filter uses truncate=4 by default. Convert that support from
    # voxels to a conservative physical margin using the largest grid spacing.
    spacings = [
        abs(x_values[1] - x_values[0]) if bins > 1 else 1.0,
        abs(y_values[1] - y_values[0]) if bins > 1 else 1.0,
        abs(z_values[1] - z_values[0]) if bins > 1 else 1.0,
    ]
    blur_margin_mm = 4.0 * sigma * max(spacings) if sigma > 0 else 0.0
    support_radius = radius + blur_margin_mm + max(spacings)
    cx, cy, cz = center

    def local_slice(values, c):
        idx = np.flatnonzero((values >= c - support_radius) & (values <= c + support_radius))
        if idx.size == 0:
            nearest = int(np.argmin(np.abs(values - c)))
            return slice(nearest, nearest + 1)
        return slice(int(idx[0]), int(idx[-1]) + 1)

    sx = local_slice(x_values, cx)
    sy = local_slice(y_values, cy)
    sz = local_slice(z_values, cz)
    x_local = x_values[sx]
    y_local = y_values[sy]
    z_local = z_values[sz]
    Z, Y, X = np.meshgrid(z_local, y_local, x_local, indexing="ij")
    local = (((X - cx) ** 2 + (Y - cy) ** 2 + (Z - cz) ** 2) <= radius ** 2).astype(np.float32)

    if not np.any(local):
        ix = coord_to_idx_axis(cx, "x", bins, coord_ranges)
        iy = coord_to_idx_axis(cy, "y", bins, coord_ranges)
        iz = coord_to_idx_axis(cz, "z", bins, coord_ranges)
        volume = np.zeros((bins, bins, bins), dtype=np.float32)
        volume[iz, iy, ix] = 1.0
    else:
        if sigma > 0:
            # constant mode avoids reflecting probability mass at a physical
            # source-region boundary.
            local = gaussian_filter(
                local,
                sigma=sigma,
                mode="constant",
                cval=0.0,
                truncate=4.0,
            ).astype(np.float32)
        volume = np.zeros((bins, bins, bins), dtype=np.float32)
        volume[sz, sy, sx] = local

    if normalize == "sum":
        total = float(volume.sum())
        if total <= 0 or not np.isfinite(total):
            raise RuntimeError("Physical sphere target has invalid total mass")
        volume /= total
    elif normalize == "max":
        m = float(volume.max())
        if m > 0:
            volume /= m
    elif normalize is not None:
        raise ValueError("normalize must be 'sum', 'max', or None")
    return volume.astype(np.float32)

def make_multi_subsource_volume(
    source_record,
    bins=50,
    sigma=0.0,
    normalize="sum",
    coord_ranges=None,
    return_components=False,
):
    """Construct the supervised 3-D target from the observed event distribution.

    No criterion label, diameter-derived intensity formula, or manually supplied
    target weight is used. Each physical subsource first becomes a unit-mass
    sphere distribution. Its contribution to the full target is then multiplied
    by the fraction of selected event rows that actually came from that
    subsource.

    Examples that arise automatically from the CSV:
      * 50 / 50 events -> weights 0.50 / 0.50
      * 6 / 94 events  -> weights 0.06 / 0.94
      * any other valid distribution is handled identically.

    The event fractions are target-generation metadata only. They are never
    passed to the neural network as input features.
    """
    record = normalize_source_record(source_record)
    weights = source_record_event_fractions(record)
    if len(weights) != record["number_of_subsources"]:
        raise RuntimeError("Target-weight count does not match number_of_subsources")

    components = []
    for sub, weight in zip(record["subsources"], weights):
        component = make_physical_sphere_volume(
            [
                sub["subsource_center_x"],
                sub["subsource_center_y"],
                sub["subsource_center_z"],
            ],
            sub["subsource_diameter"],
            bins=bins,
            sigma=sigma,
            normalize="sum",
            coord_ranges=coord_ranges,
        )
        component = component * float(weight)
        components.append(component.astype(np.float32))

    volume = np.sum(np.stack(components, axis=0), axis=0).astype(np.float32)
    if normalize == "sum":
        total = float(volume.sum())
        if total <= 0.0 or not np.isfinite(total):
            raise RuntimeError("Multi-subsource target has invalid total mass")
        volume /= total
    elif normalize == "max":
        m = float(volume.max())
        if m > 0:
            volume /= m
    elif normalize is not None:
        raise ValueError("normalize must be 'sum', 'max', or None")

    if return_components:
        return volume.astype(np.float32), components
    return volume.astype(np.float32)


def batch_make_multi_subsource_volumes_5d(source_records, bins=50, sigma=0.0, coord_ranges=None):
    volumes = [
        make_multi_subsource_volume(
            r, bins=bins, sigma=sigma, normalize="sum", coord_ranges=coord_ranges
        )
        for r in source_records
    ]
    volumes = np.asarray(volumes, dtype=np.float32)[..., np.newaxis]
    sums = volumes.reshape((volumes.shape[0], -1)).sum(axis=1)
    if not np.allclose(sums, 1.0, rtol=0.0, atol=1e-5):
        raise RuntimeError("At least one multi-subsource target is not normalized")
    return volumes


# =========================================================
# PREDICTED COMPONENT-CENTRE EXTRACTION + MATCHING (TEST EVALUATION ONLY)
# =========================================================
def extract_predicted_subsource_centres(
    pred_volume,
    number_of_subsources,
    bins=50,
    coord_ranges=None,
    random_seed=SEED,
    n_samples=EVALUATION_KMEANS_SAMPLES,
):
    """
    Estimate subsource centres from the RAW predicted probability volume.

    Evaluation knows the true number of components (2-5), but not their
    positions. We sample voxels according to the predicted probability mass
    and cluster the sampled physical coordinates with KMeans. This is much
    better than using local maxima for extended spheres: a correct uniform
    sphere can have a flat interior, so its maximum is not uniquely located at
    the sphere centre, whereas the probability centroid of that component is.
    """
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coord_ranges = normalize_coord_ranges(coord_ranges)
    volume = np.asarray(pred_volume, dtype=np.float64)
    n = int(number_of_subsources)
    if n < 1:
        raise ValueError("number_of_subsources must be >= 1")

    flat = np.maximum(volume.ravel(), 0.0)
    total = float(flat.sum())
    if not np.isfinite(total) or total <= 0.0:
        raise ValueError("Predicted volume does not contain valid probability mass")
    probs = flat / total

    sample_count = max(int(n_samples), n * 100)
    rng = np.random.default_rng(int(random_seed))
    sampled_flat = rng.choice(
        flat.size,
        size=sample_count,
        replace=True,
        p=probs,
    )
    iz, iy, ix = np.unravel_index(sampled_flat, volume.shape)

    x_values = np.linspace(coord_ranges["x"][0], coord_ranges["x"][1], bins)
    y_values = np.linspace(coord_ranges["y"][0], coord_ranges["y"][1], bins)
    z_values = np.linspace(coord_ranges["z"][0], coord_ranges["z"][1], bins)
    sampled_coords = np.column_stack([
        x_values[ix],
        y_values[iy],
        z_values[iz],
    ]).astype(np.float32)

    kmeans = KMeans(
        n_clusters=n,
        random_state=int(random_seed),
        n_init=int(EVALUATION_KMEANS_N_INIT),
        max_iter=100,
    )
    kmeans.fit(sampled_coords)
    centres = np.asarray(kmeans.cluster_centers_, dtype=np.float32)

    # Record raw prediction probability at the voxel nearest each estimated
    # centre. This is diagnostic only and is not used for matching.
    centre_probs = []
    for cx, cy, cz in centres:
        cix = coord_to_idx_axis(cx, "x", bins, coord_ranges)
        ciy = coord_to_idx_axis(cy, "y", bins, coord_ranges)
        ciz = coord_to_idx_axis(cz, "z", bins, coord_ranges)
        centre_probs.append(float(volume[ciz, ciy, cix]))

    return centres, np.asarray(centre_probs, dtype=np.float32)

def match_predicted_centres_to_true_subsources(source_record, predicted_coords, predicted_probs=None):
    record = normalize_source_record(source_record)
    true_coords = source_record_centres(record).astype(np.float64)
    predicted_coords = np.asarray(predicted_coords, dtype=np.float64)
    if predicted_coords.shape != true_coords.shape:
        raise ValueError(
            f"Predicted centre shape {predicted_coords.shape} does not match true centres {true_coords.shape}"
        )
    cost = np.linalg.norm(true_coords[:, None, :] - predicted_coords[None, :, :], axis=2)
    true_idx, pred_idx = linear_sum_assignment(cost)
    if predicted_probs is None:
        predicted_probs = np.full(len(predicted_coords), np.nan, dtype=np.float64)
    predicted_probs = np.asarray(predicted_probs, dtype=np.float64)

    rows = []
    for ti, pi in zip(true_idx, pred_idx):
        sub = record["subsources"][int(ti)]
        t = true_coords[ti]
        p = predicted_coords[pi]
        d = p - t
        rows.append({
            "source_id": int(record["source_id"]),
            "number_of_subsources": int(record["number_of_subsources"]),
            "subsource_id": int(sub["subsource_id"]),
            "subsource_diameter": int(validate_integer_subsource_diameter(sub["subsource_diameter"])),
            "true_x": float(t[0]),
            "true_y": float(t[1]),
            "true_z": float(t[2]),
            "pred_x": float(p[0]),
            "pred_y": float(p[1]),
            "pred_z": float(p[2]),
            "dx": float(d[0]),
            "dy": float(d[1]),
            "dz": float(d[2]),
            "abs_dx": float(abs(d[0])),
            "abs_dy": float(abs(d[1])),
            "abs_dz": float(abs(d[2])),
            "euclidean_distance": float(np.linalg.norm(d)),
            "predicted_centre_probability": float(predicted_probs[pi]),
        })
    return rows


def crop_around_gt_support(gt_img, pred_img, margin=3):
    gt_img = np.asarray(gt_img)
    pred_img = np.asarray(pred_img)
    occupied = np.argwhere(gt_img > 0)
    if occupied.size == 0:
        return gt_img, pred_img
    lower = np.maximum(occupied.min(axis=0) - int(margin), 0)
    upper = np.minimum(occupied.max(axis=0) + int(margin) + 1, gt_img.shape)
    z0, y0, x0 = lower
    z1, y1, x1 = upper
    return gt_img[z0:z1, y0:y1, x0:x1], pred_img[z0:z1, y0:y1, x0:x1]


def compute_ssim_3d(gt, pred):
    if not SKIMAGE_OK:
        return np.nan
    gt = np.asarray(gt, dtype=np.float32)
    pred = np.asarray(pred, dtype=np.float32)
    data_range = float(max(gt.max(), pred.max()) - min(gt.min(), pred.min()))
    if data_range <= 0 or not np.isfinite(data_range):
        data_range = 1.0
    min_dim = min(gt.shape)
    win = min(7, min_dim if min_dim % 2 == 1 else min_dim - 1)
    if win < 3:
        return np.nan
    return float(ssim(gt, pred, data_range=data_range, win_size=win))


def compute_component_local_ssim_from_arrays(full_gt, component_support, pred_volume, margin=3):
    """Local SSIM using one component only to define the crop bounds."""
    full_gt = np.asarray(full_gt)
    component_support = np.asarray(component_support)
    pred_volume = np.asarray(pred_volume)
    occupied = np.argwhere(component_support > 0)
    if occupied.size == 0:
        return np.nan
    lower = np.maximum(occupied.min(axis=0) - int(margin), 0)
    upper = np.minimum(occupied.max(axis=0) + int(margin) + 1, full_gt.shape)
    z0, y0, x0 = lower
    z1, y1, x1 = upper
    return compute_ssim_3d(
        full_gt[z0:z1, y0:y1, x0:x1],
        pred_volume[z0:z1, y0:y1, x0:x1],
    )


def compute_component_local_ssim(source_record, subsource_index, pred_volume, sigma, coord_ranges=None):
    """Compute local SSIM in a crop centred on one true subsource.

    The crop bounds come from that component, but the GT values inside the
    crop come from the complete multi-subsource target. Therefore a perfect
    full prediction gives SSIM=1 even when another true component is nearby.
    """
    record = normalize_source_record(source_record)
    full_gt, components = make_multi_subsource_volume(
        record, bins=50, sigma=sigma, normalize="sum",
        coord_ranges=coord_ranges, return_components=True
    )
    component_support = np.asarray(components[int(subsource_index)])
    return compute_component_local_ssim_from_arrays(
        full_gt, component_support, pred_volume, margin=3
    )


