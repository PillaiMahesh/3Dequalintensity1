def _format_summary_value(value, digits=6):
    try:
        value = float(value)
    except Exception:
        return "N/A"
    if not np.isfinite(value):
        return "N/A"
    return f"{value:.{digits}f}"


def compute_source_group_statistics(rows, label):
    if len(rows) == 0:
        return {
            "subsource_count_label": str(label),
            "number_of_sources": 0,
            "mean_global_centroid_error": np.nan,
            "mean_matched_subsource_error": np.nan,
            "std_matched_subsource_error": np.nan,
            "rmse_matched_subsource_error": np.nan,
            "mean_full_3d_ssim": np.nan,
            "mean_local_component_ssim": np.nan,
        }
    return {
        "subsource_count_label": str(label),
        "number_of_sources": int(len(rows)),
        "mean_global_centroid_error": float(rows["global_centroid_error"].mean()),
        "mean_matched_subsource_error": float(rows["mean_matched_subsource_error"].mean()),
        "std_matched_subsource_error": float(rows["mean_matched_subsource_error"].std(ddof=0)),
        "rmse_matched_subsource_error": float(np.sqrt(np.mean(rows["mean_matched_subsource_error"].to_numpy() ** 2))),
        "mean_full_3d_ssim": float(rows["sample_full_3d_ssim"].mean()) if "sample_full_3d_ssim" in rows else np.nan,
        "mean_local_component_ssim": float(rows["mean_local_component_ssim"].mean()) if "mean_local_component_ssim" in rows else np.nan,
    }


def save_performance_summaries(source_df, matched_df, summary_dir):
    os.makedirs(summary_dir, exist_ok=True)

    source_stats = []
    for n in range(MIN_SUBSOURCES, MAX_SUBSOURCES + 1):
        group = source_df[source_df["number_of_subsources"] == n]
        row = compute_source_group_statistics(group, n)
        row["number_of_subsources"] = n
        source_stats.append(row)
    overall = compute_source_group_statistics(source_df, "Overall")
    overall["number_of_subsources"] = np.nan
    source_stats.append(overall)
    source_stats_df = pd.DataFrame(source_stats)
    source_stats_path = os.path.join(summary_dir, "performance_by_number_of_subsources.csv")
    source_stats_df.to_csv(source_stats_path, index=False)

    diameter_rows = []
    for diameter, g in matched_df.groupby("subsource_diameter", sort=True):
        diameter_rows.append({
            "subsource_diameter_mm": int(diameter),
            "number_of_subsources": int(len(g)),
