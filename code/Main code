# MODEL 3D volume output
# =========================================================
def create_volume_model(
    input_shape=(None, 1, 8),
    lr=1e-3,
    temperature=1.0,
    tv_lambda=0.0,
    jsd_weight=JSD_LOSS_WEIGHT,
    ssim_weight=PROJECTION_SSIM_LOSS_WEIGHT,
    cdf_weight=MARGINAL_CDF_LOSS_WEIGHT,
    extent_weight=EXTENT_LOSS_WEIGHT,
    ssim_max_val=1.0,
):
    inputs = layers.Input(shape=input_shape)

    event_mask = layers.Lambda(
        lambda t: tf.logical_not(tf.reduce_all(tf.equal(t, PAD_VALUE), axis=[2, 3])),
        output_shape=(None,),
        name="event_mask",
    )(inputs)

    x = layers.TimeDistributed(layers.Flatten(), name="event_flatten")(inputs)

    x = layers.Dense(64, activation="relu", name="event_dense_64")(x)
    x = layers.Dense(128, activation="relu", name="event_dense_128")(x)
    event_embeddings = layers.Dense(256, activation="relu", name="event_dense_256")(x)
    event_embeddings = layers.Dropout(0.10, name="event_embedding_dropout")(event_embeddings)

    # Existing sequential representation: retained because it already gives
    # strong localization performance.
    lstm_features = layers.Bidirectional(
        layers.LSTM(128, return_sequences=True),
        name="bilstm_128",
    )(event_embeddings, mask=event_mask)
    lstm_features = layers.Bidirectional(
        layers.LSTM(64),
        name="bilstm_64",
    )(lstm_features, mask=event_mask)

    # New lightweight set-level representation. A small learned projection is
    # used so mean/std/max pooling adds very little compute compared with the
    # 3-D decoder while explicitly preserving population-spread information.
    if USE_EVENT_STATS_POOLING:
        stats_embeddings = layers.Dense(
            EVENT_STATS_PROJECTION_DIM,
            activation="relu",
            name="event_stats_projection",
        )(event_embeddings)
        stats_features = MaskedEventStatisticsLayer(
            name="masked_event_statistics",
        )([stats_embeddings, event_mask])
        fused_features = layers.Concatenate(name="lstm_stats_fusion")([
            lstm_features,
            stats_features,
        ])
    else:
        fused_features = lstm_features

    x = layers.Dense(
        512,
        activation="relu",
        kernel_regularizer=regularizers.l2(5e-4),
        name="fusion_dense_512",
    )(fused_features)
    x = layers.Dropout(0.30, name="fusion_dropout")(x)

    # Original lightweight decoder is intentionally preserved.
    x = layers.Dense(
        10 * 10 * 10 * 8,
        activation="relu",
        kernel_regularizer=regularizers.l2(5e-4),
        name="decoder_dense",
    )(x)
    x = layers.Dropout(0.30, name="decoder_dropout")(x)
    x = layers.Reshape((10, 10, 10, 8), name="decoder_reshape")(x)

    x = layers.Conv3D(16, kernel_size=3, padding="same", activation="relu", name="decoder_conv3d_16")(x)
    x = layers.BatchNormalization(name="decoder_bn_16")(x)

    x = layers.UpSampling3D(size=(5, 5, 5), name="decoder_upsample_5x")(x)
    x = layers.Conv3D(8, kernel_size=3, padding="same", activation="relu", name="decoder_conv3d_8a")(x)
    x = layers.BatchNormalization(name="decoder_bn_8a")(x)
    x = layers.Conv3D(8, kernel_size=3, padding="same", activation="relu", name="decoder_conv3d_8b")(x)
    x = layers.BatchNormalization(name="decoder_bn_8b")(x)

    logits = layers.Conv3D(1, kernel_size=1, padding="same", activation=None, name="logits")(x)
    logits_scaled = TemperatureScalingLayer(temperature=temperature, name="temp_scale")(logits)
    volume = SpatialSoftmax3DLayer(bins=50, name="volume_out")(logits_scaled)
    volume = TVRegularization3DLayer(tv_lambda=tv_lambda, name="tv_regularization")(volume)

    model = models.Model(inputs, volume)

    # These metrics are useful diagnostics but expensive because they repeat
    # large 3-D reductions already performed inside the training loss. They do
    # not affect gradients. Test mode computes the scientific evaluation
    # metrics separately, so fast training can safely omit them.
    training_metrics = []
    if COMPUTE_EXPENSIVE_TRAINING_METRICS:
        training_metrics = [
            spatial_kld_3d,
            mean_projection_ssim_metric,
            mean_marginal_cdf_error_metric,
            mean_spatial_extent_error_mm_metric,
        ]

    model.compile(
        optimizer=tf.keras.optimizers.Adam(learning_rate=lr, clipnorm=1.0),
        loss=LightweightCDFExtentLoss(
            jsd_weight=jsd_weight,
            ssim_weight=ssim_weight,
            cdf_weight=cdf_weight,
            extent_weight=extent_weight,
            ssim_max_val=ssim_max_val,
        ),
        metrics=training_metrics,
        steps_per_execution=int(STEPS_PER_EXECUTION),
    )
    return model

