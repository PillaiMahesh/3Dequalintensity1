def print_kaggle_input_tree(root=KAGGLE_INPUT_ROOT, max_depth=3, max_files_per_dir=12):
    if not os.path.exists(root):
        print(f"Input root does not exist: {root}")
        return

    root = os.path.abspath(root)
    print(f"\nInput tree preview: {root}")
    for current, dirs, files in os.walk(root):
        rel = os.path.relpath(current, root)
        depth = 0 if rel == "." else rel.count(os.sep) + 1
        if depth > max_depth:
            dirs[:] = []
            continue

        indent = "  " * depth
        name = os.path.basename(current) if rel != "." else os.path.basename(root)
        print(f"{indent}{name}/")

        for f in files[:max_files_per_dir]:
            print(f"{indent}  {f}")
        if len(files) > max_files_per_dir:
            print(f"{indent}  ... {len(files) - max_files_per_dir} more files")


def resolve_csv_path(user_path, purpose):
    """Resolve a multi-subsource event CSV path."""
    if user_path and os.path.exists(user_path):
        return os.path.abspath(user_path)

    if user_path and not os.path.exists(user_path):
        raise FileNotFoundError(
            f"{purpose} CSV path was set but does not exist:\n{user_path}\n"
            "Check the exact Kaggle path or leave the setting blank for auto-find."
        )

    search_roots = [
        KAGGLE_INPUT_ROOT,
        os.path.join(KAGGLE_WORKING_ROOT, "outputs"),
    ]

    candidates = []
    for root in search_roots:
        if os.path.exists(root):
            candidates.extend(glob.glob(os.path.join(root, "**", "*.csv"), recursive=True))
    candidates = sorted(set(candidates))

    if not candidates:
        print_kaggle_input_tree()
        raise FileNotFoundError(
            f"Could not auto-find a {purpose} CSV under {search_roots}."
        )

    def preference_key(path):
        name = os.path.basename(path).lower()
        multi = ("multisource" in name and "event" in name)
        source_event = ("source" in name and "event" in name)
        return (not multi, not source_event, path)

    candidates = sorted(candidates, key=preference_key)
    chosen = candidates[0]
    print(f"Auto-selected {purpose} CSV:", chosen)
    return os.path.abspath(chosen)


def find_artifact_folder(user_folder=""):
    required_core = ["best_model.keras", "scaler.pkl", "meta.json"]

    def valid_folder(folder):
        return all(os.path.exists(os.path.join(folder, name)) for name in required_core)

    if user_folder:
        user_folder = os.path.abspath(user_folder)
        if not os.path.isdir(user_folder):
            raise FileNotFoundError(f"INFERENCE_ARTIFACTS_FOLDER is not a folder: {user_folder}")
        if not valid_folder(user_folder):
            missing = [name for name in required_core if not os.path.exists(os.path.join(user_folder, name))]
            raise FileNotFoundError(
                f"INFERENCE_ARTIFACTS_FOLDER exists, but missing required files: {missing}\n"
                f"Folder: {user_folder}"
            )
        return user_folder

    search_roots = [KAGGLE_INPUT_ROOT, KAGGLE_WORKING_ROOT]
    model_paths = []
    for root in search_roots:
        if os.path.exists(root):
            model_paths.extend(glob.glob(os.path.join(root, "**", "best_model.keras"), recursive=True))

    candidate_folders = sorted({os.path.dirname(p) for p in model_paths})
    valid = [folder for folder in candidate_folders if valid_folder(folder)]
    if not valid:
        raise FileNotFoundError("No valid multi-subsource artifact folder found.")

    preferred = [
        f for f in valid
        if run_label.lower() in f.lower()
        or "eventdriven_intensity_adaptive" in f.lower()
    ]
    if not preferred:
        preferred = [f for f in valid if "multisubsource" in f.lower()]
    chosen = (preferred or valid)[0]
    print("Auto-selected inference artifacts folder:", chosen)
    return chosen


