# LOSSES, METRICS, CUSTOM LAYERS, AND MODEL (PRESERVED)
# =========================================================
def spatial_kld_3d(y_true, y_pred):
    yt = tf.reshape(y_true, (-1, 50 * 50 * 50))
    yp = tf.reshape(y_pred, (-1, 50 * 50 * 50))
    return tf.keras.losses.KLDivergence()(yt, yp)


def spatial_jsd_3d(y_true, y_pred, eps=1e-7):
    yt = tf.reshape(y_true, (-1, 50 * 50 * 50))
    yp = tf.reshape(y_pred, (-1, 50 * 50 * 50))

    yt = yt / tf.maximum(
        tf.reduce_sum(yt, axis=-1, keepdims=True),
        tf.cast(eps, yt.dtype),
    )
    yp = yp / tf.maximum(
        tf.reduce_sum(yp, axis=-1, keepdims=True),
        tf.cast(eps, yp.dtype),
    )
    midpoint = 0.5 * (yt + yp)

    kl_true_mid = tf.reduce_sum(
        tf.where(
            yt > 0.0,
            yt * tf.math.log((yt + eps) / (midpoint + eps)),
            tf.zeros_like(yt),
        ),
        axis=-1,
    )
    kl_pred_mid = tf.reduce_sum(
        tf.where(
            yp > 0.0,
            yp * tf.math.log((yp + eps) / (midpoint + eps)),
            tf.zeros_like(yp),
        ),
        axis=-1,
    )
    return tf.reduce_mean(0.5 * (kl_true_mid + kl_pred_mid))


def _sum_projection_tensors(t):
    # t: [B, Z, Y, X, 1]
    proj_xy = tf.reduce_sum(t, axis=1)  # [B, Y, X, 1]
    proj_xz = tf.reduce_sum(t, axis=2)  # [B, Z, X, 1]
    proj_yz = tf.reduce_sum(t, axis=3)  # [B, Z, Y, 1]

    def normalize_projection(projection):
        maximum = tf.reduce_max(projection, axis=[1, 2, 3], keepdims=True)
        return projection / tf.maximum(maximum, tf.constant(1e-8, projection.dtype))

    return (
        normalize_projection(proj_xy),
        normalize_projection(proj_xz),
        normalize_projection(proj_yz),
    )


def projection_ssim_loss(y_true, y_pred, max_val=1.0):
    true_xy, true_xz, true_yz = _sum_projection_tensors(y_true)
    pred_xy, pred_xz, pred_yz = _sum_projection_tensors(y_pred)

    ssim_xy = tf.image.ssim(true_xy, pred_xy, max_val=max_val)
    ssim_xz = tf.image.ssim(true_xz, pred_xz, max_val=max_val)
    ssim_yz = tf.image.ssim(true_yz, pred_yz, max_val=max_val)

    ssim_mean = (
        tf.reduce_mean(ssim_xy)
        + tf.reduce_mean(ssim_xz)
        + tf.reduce_mean(ssim_yz)
    ) / 3.0
    return 1.0 - ssim_mean


def make_jsd_projection_ssim_loss(
    jsd_weight=1.0,
    ssim_weight=0.2,
    max_val=1.0,
):
    # Retained for backward compatibility with older saved artifacts.
    def loss(y_true, y_pred):
        jsd = spatial_jsd_3d(y_true, y_pred)
        ssim_l = projection_ssim_loss(y_true, y_pred, max_val=max_val)
        return jsd_weight * jsd + ssim_weight * ssim_l
    return loss


def _normalize_probability_volume_tensor(t, eps=1e-8):
    """Normalize a [B,Z,Y,X,1] non-negative tensor to unit mass per sample."""
    t = tf.cast(t, tf.float32)
    t = tf.maximum(t, 0.0)
    total = tf.reduce_sum(t, axis=[1, 2, 3, 4], keepdims=True)
    return t / tf.maximum(total, tf.cast(eps, t.dtype))


def _axis_marginal_probabilities(t):
    """
    Return normalized X/Y/Z marginal probability profiles from a 3-D volume.

    Input layout: [B, Z, Y, X, 1]
    Outputs: px, py, pz, each with shape [B, 50].

    This operation is inexpensive: it only reduces the existing volume and
    performs the shape comparison on 3 x 50 values per sample.
    """
    p = _normalize_probability_volume_tensor(t)

    px = tf.reduce_sum(p, axis=[1, 2, 4])  # [B, X]
    py = tf.reduce_sum(p, axis=[1, 3, 4])  # [B, Y]
    pz = tf.reduce_sum(p, axis=[2, 3, 4])  # [B, Z]

    # Numerical guard: each marginal should sum to one, but normalize again
    # after reductions to avoid tiny floating-point drift.
    eps = tf.constant(1e-8, tf.float32)
    px = px / tf.maximum(tf.reduce_sum(px, axis=1, keepdims=True), eps)
    py = py / tf.maximum(tf.reduce_sum(py, axis=1, keepdims=True), eps)
    pz = pz / tf.maximum(tf.reduce_sum(pz, axis=1, keepdims=True), eps)
    return px, py, pz


def marginal_cdf_shape_loss_3d(y_true, y_pred):
    """
    Shape-agnostic marginal-CDF loss.

    For each 3-D heatmap, collapse the volume into its X, Y and Z probability
    profiles, convert those profiles into cumulative distributions, and match
    the complete CDFs rather than only one width statistic.

    This directly penalizes a prediction that is systematically too broad or
    too narrow while remaining compatible with future irregular shapes. No
    sphere diameter, radius, circular boundary or radial symmetry is assumed.
    """
    true_px, true_py, true_pz = _axis_marginal_probabilities(y_true)
    pred_px, pred_py, pred_pz = _axis_marginal_probabilities(y_pred)

    true_cdf_x = tf.cumsum(true_px, axis=1)
    true_cdf_y = tf.cumsum(true_py, axis=1)
    true_cdf_z = tf.cumsum(true_pz, axis=1)

    pred_cdf_x = tf.cumsum(pred_px, axis=1)
    pred_cdf_y = tf.cumsum(pred_py, axis=1)
    pred_cdf_z = tf.cumsum(pred_pz, axis=1)

    # Mean absolute CDF discrepancy per axis, then average over axes/samples.
    loss_x = tf.reduce_mean(tf.abs(pred_cdf_x - true_cdf_x), axis=1)
    loss_y = tf.reduce_mean(tf.abs(pred_cdf_y - true_cdf_y), axis=1)
    loss_z = tf.reduce_mean(tf.abs(pred_cdf_z - true_cdf_z), axis=1)

    return tf.reduce_mean((loss_x + loss_y + loss_z) / 3.0)


def _spatial_standard_deviations_mm(t):
    """
    Return probability-weighted spatial standard deviations (sx, sy, sz) in
    physical millimetres. This is a lightweight secondary global-width signal.
    """
    px, py, pz = _axis_marginal_probabilities(t)

    x = tf.linspace(
        tf.cast(COORD_RANGES["x"][0], tf.float32),
        tf.cast(COORD_RANGES["x"][1], tf.float32),
        50,
    )[tf.newaxis, :]
    y = tf.linspace(
        tf.cast(COORD_RANGES["y"][0], tf.float32),
        tf.cast(COORD_RANGES["y"][1], tf.float32),
        50,
    )[tf.newaxis, :]
    z = tf.linspace(
        tf.cast(COORD_RANGES["z"][0], tf.float32),
        tf.cast(COORD_RANGES["z"][1], tf.float32),
        50,
    )[tf.newaxis, :]

    mx = tf.reduce_sum(px * x, axis=1, keepdims=True)
    my = tf.reduce_sum(py * y, axis=1, keepdims=True)
    mz = tf.reduce_sum(pz * z, axis=1, keepdims=True)

    vx = tf.reduce_sum(px * tf.square(x - mx), axis=1)
    vy = tf.reduce_sum(py * tf.square(y - my), axis=1)
    vz = tf.reduce_sum(pz * tf.square(z - mz), axis=1)

    eps = tf.constant(1e-8, tf.float32)
    sx = tf.sqrt(tf.maximum(vx, eps))
    sy = tf.sqrt(tf.maximum(vy, eps))
    sz = tf.sqrt(tf.maximum(vz, eps))
    return sx, sy, sz


def spatial_extent_loss_3d(y_true, y_pred):
    """
    Secondary global spread loss. It compares physical X/Y/Z standard
    deviations but does not use diameter as a target.

    The primary size/shape supervision is marginal_cdf_shape_loss_3d(); this
    term only stabilizes the overall spatial extent.
    """
    true_sx, true_sy, true_sz = _spatial_standard_deviations_mm(y_true)
    pred_sx, pred_sy, pred_sz = _spatial_standard_deviations_mm(y_pred)

    span_x = tf.cast(COORD_RANGES["x"][1] - COORD_RANGES["x"][0], tf.float32)
    span_y = tf.cast(COORD_RANGES["y"][1] - COORD_RANGES["y"][0], tf.float32)
    span_z = tf.cast(COORD_RANGES["z"][1] - COORD_RANGES["z"][0], tf.float32)

    ex = tf.abs(pred_sx - true_sx) / tf.maximum(span_x, 1e-8)
    ey = tf.abs(pred_sy - true_sy) / tf.maximum(span_y, 1e-8)
    ez = tf.abs(pred_sz - true_sz) / tf.maximum(span_z, 1e-8)
    return tf.reduce_mean((ex + ey + ez) / 3.0)


def mean_marginal_cdf_error_metric(y_true, y_pred):
    """Training metric: mean absolute marginal-CDF mismatch (lower is better)."""
    return marginal_cdf_shape_loss_3d(y_true, y_pred)


def mean_spatial_extent_error_mm_metric(y_true, y_pred):
    """Training metric: mean absolute X/Y/Z std-deviation error in mm."""
    true_sx, true_sy, true_sz = _spatial_standard_deviations_mm(y_true)
    pred_sx, pred_sy, pred_sz = _spatial_standard_deviations_mm(y_pred)
    per_sample = (
        tf.abs(pred_sx - true_sx)
        + tf.abs(pred_sy - true_sy)
        + tf.abs(pred_sz - true_sz)
    ) / 3.0
    return tf.reduce_mean(per_sample)


@register_keras_serializable(package="Custom")
class LightweightCDFExtentLoss(tf.keras.losses.Loss):
    """
    Original probability/localization objective plus two inexpensive,
    shape-agnostic spatial-distribution constraints.
    """

    def __init__(
        self,
        jsd_weight=1.0,
        ssim_weight=0.2,
        cdf_weight=1.0,
        extent_weight=0.5,
        ssim_max_val=1.0,
        name="lightweight_cdf_extent_loss",
        **kwargs,
    ):
        super().__init__(name=name, **kwargs)
        self.jsd_weight = float(jsd_weight)
        self.ssim_weight = float(ssim_weight)
        self.cdf_weight = float(cdf_weight)
        self.extent_weight = float(extent_weight)
        self.ssim_max_val = float(ssim_max_val)

    def call(self, y_true, y_pred):
        jsd = spatial_jsd_3d(y_true, y_pred)
        ssim_l = projection_ssim_loss(
            y_true,
            y_pred,
            max_val=self.ssim_max_val,
        )
        cdf_l = marginal_cdf_shape_loss_3d(y_true, y_pred)
        extent_l = spatial_extent_loss_3d(y_true, y_pred)

        return (
            self.jsd_weight * jsd
            + self.ssim_weight * ssim_l
            + self.cdf_weight * cdf_l
            + self.extent_weight * extent_l
        )

    def get_config(self):
        config = super().get_config()
        config.update({
            "jsd_weight": self.jsd_weight,
            "ssim_weight": self.ssim_weight,
            "cdf_weight": self.cdf_weight,
            "extent_weight": self.extent_weight,
            "ssim_max_val": self.ssim_max_val,
        })
        return config


def mean_projection_ssim_metric(y_true, y_pred):
    true_xy, true_xz, true_yz = _sum_projection_tensors(y_true)
    pred_xy, pred_xz, pred_yz = _sum_projection_tensors(y_pred)

    ssim_xy = tf.reduce_mean(tf.image.ssim(true_xy, pred_xy, max_val=1.0))
    ssim_xz = tf.reduce_mean(tf.image.ssim(true_xz, pred_xz, max_val=1.0))
    ssim_yz = tf.reduce_mean(tf.image.ssim(true_yz, pred_yz, max_val=1.0))
    return (ssim_xy + ssim_xz + ssim_yz) / 3.0


# =========================================================
# SERIALIZABLE CUSTOM LAYERS
# =========================================================
@register_keras_serializable(package="Custom")
class MaskedEventStatisticsLayer(layers.Layer):
    """Masked mean/std/max pooling over learned event embeddings.

    Inputs:
        [features, event_mask]
        features:   [batch, events, channels]
        event_mask: [batch, events] boolean

    Output:
        concatenated [mean, std, max] with shape [batch, 3 * channels].

    This layer is permutation-invariant over events and adds only lightweight
    set-level information alongside the existing BiLSTM representation.
    """

    def __init__(self, epsilon=1e-6, **kwargs):
        super().__init__(**kwargs)
        self.epsilon = float(epsilon)

    def call(self, inputs):
        features, event_mask = inputs
        features = tf.cast(features, tf.float32)
        event_mask = tf.cast(event_mask, tf.bool)

        mask = tf.cast(event_mask, features.dtype)[..., tf.newaxis]
        count = tf.reduce_sum(mask, axis=1)
        safe_count = tf.maximum(count, tf.ones_like(count))

        mean = tf.reduce_sum(features * mask, axis=1) / safe_count

        centered = features - mean[:, tf.newaxis, :]
        variance = tf.reduce_sum(tf.square(centered) * mask, axis=1) / safe_count
        std = tf.sqrt(tf.maximum(variance, tf.cast(self.epsilon, features.dtype)))

        very_negative = tf.cast(-1e9, features.dtype)
        masked_for_max = tf.where(
            event_mask[..., tf.newaxis],
            features,
            very_negative,
        )
        maximum = tf.reduce_max(masked_for_max, axis=1)
        has_valid = tf.reduce_any(event_mask, axis=1, keepdims=True)
        maximum = tf.where(has_valid, maximum, tf.zeros_like(maximum))

        return tf.concat([mean, std, maximum], axis=-1)

    def get_config(self):
        config = super().get_config()
        config.update({"epsilon": self.epsilon})
        return config


@register_keras_serializable(package="Custom")
class TemperatureScalingLayer(layers.Layer):
    def __init__(self, temperature=1.0, **kwargs):
        super().__init__(**kwargs)
        self.temperature = float(temperature)

    def call(self, inputs):
        return tf.cast(inputs, tf.float32) / tf.cast(self.temperature, tf.float32)

    def get_config(self):
        config = super().get_config()
        config.update({"temperature": self.temperature})
        return config


@register_keras_serializable(package="Custom")
class SpatialSoftmax3DLayer(layers.Layer):
    def __init__(self, bins=50, **kwargs):
        super().__init__(**kwargs)
        self.bins = int(bins)

    def call(self, inputs):
        x = tf.reshape(inputs, (-1, self.bins * self.bins * self.bins))
        x = tf.nn.softmax(x, axis=-1)
        return tf.reshape(x, (-1, self.bins, self.bins, self.bins, 1))

    def get_config(self):
        config = super().get_config()
        config.update({"bins": self.bins})
        return config


@register_keras_serializable(package="Custom")
class TVRegularization3DLayer(layers.Layer):
    def __init__(self, tv_lambda=0.0, **kwargs):
        super().__init__(**kwargs)
        self.tv_lambda = float(tv_lambda)

    def call(self, inputs):
        if self.tv_lambda > 0.0:
            dz = tf.abs(inputs[:, 1:, :, :, :] - inputs[:, :-1, :, :, :])
            dy = tf.abs(inputs[:, :, 1:, :, :] - inputs[:, :, :-1, :, :])
            dx = tf.abs(inputs[:, :, :, 1:, :] - inputs[:, :, :, :-1, :])
            tv_value = tf.reduce_mean(dz) + tf.reduce_mean(dy) + tf.reduce_mean(dx)
            self.add_loss(self.tv_lambda * tv_value)
        return inputs

    def get_config(self):
        config = super().get_config()
        config.update({"tv_lambda": self.tv_lambda})
        return config


