def normalize_coord_ranges(coord_ranges):
    out = {}
    for axis in ["x", "y", "z"]:
        if axis not in coord_ranges:
            raise ValueError(f"Missing axis '{axis}' in coord_ranges")
        lo, hi = coord_ranges[axis]
        out[axis] = (float(lo), float(hi))
    return out


def get_coord_ranges_from_meta(meta):
    if isinstance(meta, dict) and "coord_ranges" in meta:
        return normalize_coord_ranges(meta["coord_ranges"])
    return normalize_coord_ranges(COORD_RANGES)


def coord_to_idx_axis(v, axis, bins=50, coord_ranges=None):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coord_ranges = normalize_coord_ranges(coord_ranges)
    vmin, vmax = coord_ranges[axis]
    t = (float(v) - vmin) / (vmax - vmin)
    return int(np.clip(round(t * (bins - 1)), 0, bins - 1))


def idx_to_coord_axis(i, axis, bins=50, coord_ranges=None):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coord_ranges = normalize_coord_ranges(coord_ranges)
    vmin, vmax = coord_ranges[axis]
    if bins <= 1:
        return float(vmin)
    t = float(i) / float(bins - 1)
    return float(vmin + t * (vmax - vmin))


def coord_to_grid_0_50_axis(v, axis, coord_ranges=None):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coord_ranges = normalize_coord_ranges(coord_ranges)
    vmin, vmax = coord_ranges[axis]
    t = (float(v) - vmin) / (vmax - vmin)
    return float(np.clip(t * 50.0, 0.0, 50.0))


def idx_to_coord(ix, iy, iz, bins=50, coord_ranges=None):
    return (
        idx_to_coord_axis(ix, "x", bins, coord_ranges),
        idx_to_coord_axis(iy, "y", bins, coord_ranges),
        idx_to_coord_axis(iz, "z", bins, coord_ranges),
    )


def axis_extent(axis_a, axis_b, coord_ranges=None):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coord_ranges = normalize_coord_ranges(coord_ranges)
    return [
        coord_ranges[axis_a][0], coord_ranges[axis_a][1],
        coord_ranges[axis_b][0], coord_ranges[axis_b][1],
    ]


def axis_ticks(axis, coord_ranges=None, n=6):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    lo, hi = normalize_coord_ranges(coord_ranges)[axis]
    return np.linspace(lo, hi, n)


