def build_test_from_csv(
    df_test,
    requested_records,
    scaler,
    feature_cols,
    min_events_per_source=None,
    max_events_per_source=None,
    sequence_pad_length=None,
    manifest_output_dir=None,
    coord_ranges=None,
):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    df_test = df_test.copy()
    if "energy_abs" in feature_cols and "energy_abs" not in df_test.columns:
        df_test["energy_abs"] = 1 - pd.to_numeric(df_test["e_energy"], errors="raise")
    df_test, all_records = prepare_and_validate_multisource_dataframe(
        df_test, feature_cols=feature_cols, label="test CSV", coord_ranges=coord_ranges
    )

    record_by_id = {r["source_id"]: r for r in all_records}
    if TEST_SOURCE_MODE == "all_csv" or requested_records is None:
        source_ids = sorted(record_by_id)
    else:
        source_ids = [int(normalize_source_record(r)["source_id"]) for r in requested_records]

    grouped = {int(k): g for k, g in df_test.groupby("source_id", sort=False)}
    raw_inputs, raw_points, raw_subsource_ids, records_found = [], [], [], []
    missing = []
    for source_id in source_ids:
        if source_id not in grouped:
            missing.append(source_id)
            continue
        g = grouped[source_id]
        raw_inputs.append(np.nan_to_num(g[feature_cols].to_numpy()).astype(np.float32))
        raw_points.append(g[["source_x", "source_y", "source_z"]].to_numpy(dtype=np.float32))
        raw_subsource_ids.append(g["subsource_id"].to_numpy(dtype=np.int64))
        records_found.append(record_by_id[source_id])
    if missing:
        print(f"Warning: {len(missing)} requested source IDs missing; examples: {missing[:5]}")
    if not raw_inputs:
        raise ValueError("No requested overall sources were found in the test CSV")

    min_events, max_events = validate_random_event_range(min_events_per_source, max_events_per_source)
    if sequence_pad_length is None:
        sequence_pad_length = max_events
    sequence_pad_length = int(sequence_pad_length)

    selected_inputs, selected_points, actual_records, manifest_rows = sample_variable_split(
        raw_inputs,
        raw_points,
        raw_subsource_ids,
        records_found,
        "external_test",
        np.random.default_rng(SEED + 404),
        min_events,
        max_events,
    )
    if not selected_inputs:
        raise ValueError("No test source survived event selection")

    test_x = np.stack([
        transform_and_pad_sequence(X, scaler, sequence_pad_length, PAD_VALUE)
        for X in selected_inputs
    ]).astype(np.float32)
    test_x = test_x.reshape(test_x.shape[0], test_x.shape[1], 1, test_x.shape[2])

    manifest_df = pd.DataFrame(manifest_rows)
    if manifest_output_dir is None:
        manifest_output_dir = output_folder
    os.makedirs(manifest_output_dir, exist_ok=True)
    manifest_path = os.path.join(manifest_output_dir, "event_selection_manifest_external_test.csv")
    manifest_df.to_csv(manifest_path, index=False)
    return test_x, selected_points, actual_records, manifest_df, sequence_pad_length


