def _projection_density(coords_physical, pair="xy", bins=50, coord_ranges=None):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coords_physical = np.asarray(coords_physical, dtype=np.float32)
    grid = np.zeros((bins, bins), dtype=np.float64)
    xs = np.array([coord_to_idx_axis(v, "x", bins, coord_ranges) for v in coords_physical[:, 0]])
    ys = np.array([coord_to_idx_axis(v, "y", bins, coord_ranges) for v in coords_physical[:, 1]])
    zs = np.array([coord_to_idx_axis(v, "z", bins, coord_ranges) for v in coords_physical[:, 2]])
    if pair == "xy":
        np.add.at(grid, (ys, xs), 1)
    elif pair == "xz":
        np.add.at(grid, (zs, xs), 1)
    elif pair == "yz":
        np.add.at(grid, (zs, ys), 1)
    else:
        raise ValueError("pair must be xy/xz/yz")
    if grid.max() > 0:
        grid /= grid.max()
    return grid


