def load_artifacts_for_inference():
    patch_keras_lambda_event_mask_output_shape()
    folder, model_path, scaler_path, split_path, meta_path = get_inference_paths()

    custom_objects = {
        "spatial_kld_3d": spatial_kld_3d,
        "mean_projection_ssim_metric": mean_projection_ssim_metric,
        "spatial_jsd_3d": spatial_jsd_3d,
        "projection_ssim_loss": projection_ssim_loss,
        "make_jsd_projection_ssim_loss": make_jsd_projection_ssim_loss,
        "marginal_cdf_shape_loss_3d": marginal_cdf_shape_loss_3d,
        "spatial_extent_loss_3d": spatial_extent_loss_3d,
        "mean_marginal_cdf_error_metric": mean_marginal_cdf_error_metric,
        "mean_spatial_extent_error_mm_metric": mean_spatial_extent_error_mm_metric,
        "LightweightCDFExtentLoss": LightweightCDFExtentLoss,
        "MaskedEventStatisticsLayer": MaskedEventStatisticsLayer,
        "TemperatureScalingLayer": TemperatureScalingLayer,
        "SpatialSoftmax3DLayer": SpatialSoftmax3DLayer,
        "TVRegularization3DLayer": TVRegularization3DLayer,
    }

    model = tf.keras.models.load_model(
        model_path, custom_objects=custom_objects, compile=False, safe_mode=False
    )
    model = patch_loaded_model_lambda_globals(model)
    scaler = joblib.load(scaler_path)

    split = None
    if os.path.exists(split_path):
        with open(split_path, "r") as f:
            split = json.load(f)
    with open(meta_path, "r") as f:
        meta = json.load(f)

    if meta.get("prediction_target") != "multi_subsource_physical_3d":
        raise ValueError(
            "The selected artifacts belong to an incompatible model. "
            "Retrain this adaptive multi-subsource code before TEST mode."
        )

    expected_target_representation = (
        "observed_event_fraction_weighted_physical_subspheres"
    )
    if meta.get("target_representation") != expected_target_representation:
        raise ValueError(
            "The selected artifacts were trained with a different target "
            "weighting rule. Retrain using this adaptive code so the model "
            "learns from the observed event distribution without a criterion "
            "label."
        )

    feature_cols = meta["feature_cols"]
    validate_model_feature_columns(feature_cols)
    coord_ranges = get_coord_ranges_from_meta(meta)
    test_records = None
    if split is not None:
        test_records = split.get("test_source_records")
    return model, scaler, test_records, feature_cols, meta, coord_ranges, folder


# =========================================================
# DATA VALIDATION
# =========================================================
def validate_required_columns(df, feature_cols=None):
    required = [
        "source_id",
        "number_of_subsources",
        "subsource_id",
        "subsource_center_x",
        "subsource_center_y",
        "subsource_center_z",
        "subsource_diameter",
        "source_x",
        "source_y",
        "source_z",
        "e_energy",
    ]
    if feature_cols is not None:
        required += list(feature_cols)
    missing = [c for c in sorted(set(required)) if c not in df.columns]
    if missing:
        raise ValueError(
            f"CSV is missing required multi-subsource columns: {missing}\n"
            "Use a compatible multi-subsource simulator CSV with source_id, "
            "number_of_subsources, subsource_id, subsource centre/diameter, "
            "source_x/y/z and detector-event columns."
        )


def prepare_and_validate_multisource_dataframe(df, feature_cols=None, label="dataset", coord_ranges=None):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coord_ranges = normalize_coord_ranges(coord_ranges)
    df = df.copy()
    validate_required_columns(df, feature_cols)

    numeric_cols = [
        "source_id", "number_of_subsources", "subsource_id",
        "subsource_center_x", "subsource_center_y", "subsource_center_z",
        "subsource_diameter", "source_x", "source_y", "source_z", "e_energy",
    ]
    if "event_id" in df.columns:
        numeric_cols.append("event_id")
    if "theta" in df.columns:
        numeric_cols.append("theta")
    if feature_cols is not None:
        numeric_cols += list(feature_cols)

    for col in sorted(set(numeric_cols)):
        df[col] = pd.to_numeric(df[col], errors="raise")
    if df[sorted(set(numeric_cols))].isna().any().any():
        raise ValueError(f"{label} contains NaN values in required numeric columns")

    for col in ["source_id", "number_of_subsources", "subsource_id"]:
        vals = df[col].to_numpy(dtype=np.float64)
        if not np.all(np.isclose(vals, np.round(vals), rtol=0.0, atol=1e-9)):
            raise ValueError(f"{col} must contain integer-valued data")
        df[col] = np.round(vals).astype(np.int64)

    df["subsource_diameter"] = df["subsource_diameter"].map(
        validate_integer_subsource_diameter
    ).astype(np.int32)

    invalid_counts = ~df["number_of_subsources"].between(MIN_SUBSOURCES, MAX_SUBSOURCES)
    if invalid_counts.any():
        raise ValueError(
            f"number_of_subsources must be {MIN_SUBSOURCES}-{MAX_SUBSOURCES} inclusive"
        )

    if "event_id" in df.columns:
        dup = df.duplicated(subset=["source_id", "event_id"], keep=False)
        if dup.any():
            raise ValueError("Duplicate event_id values found within at least one overall source")

    # One declared count per overall source.
    declared_count_nunique = df.groupby("source_id")["number_of_subsources"].nunique()
    if (declared_count_nunique != 1).any():
        raise ValueError("At least one source_id has inconsistent number_of_subsources")

    # One geometry per (source_id, subsource_id).
    geometry_unique = df.groupby(["source_id", "subsource_id"], sort=False).agg(
        cx=("subsource_center_x", "nunique"),
        cy=("subsource_center_y", "nunique"),
        cz=("subsource_center_z", "nunique"),
        diameter=("subsource_diameter", "nunique"),
    )
    bad_geometry = geometry_unique[(geometry_unique != 1).any(axis=1)]
    if not bad_geometry.empty:
        raise ValueError(
            "At least one (source_id, subsource_id) maps to multiple geometries. "
            f"Examples: {bad_geometry.index[:10].tolist()}"
        )

    source_records = []
    for source_id, g in df.groupby("source_id", sort=True):
        record = build_source_record_from_group(g)
        expected_ids = list(range(record["number_of_subsources"]))
        actual_ids = [s["subsource_id"] for s in record["subsources"]]
        if actual_ids != expected_ids:
            raise ValueError(
                f"source_id={source_id} must contain subsource IDs {expected_ids}, got {actual_ids}"
            )

        # Boundary and pairwise non-overlap checks.
        centres = source_record_centres(record).astype(np.float64)
        diameters = source_record_diameters(record).astype(np.float64)
        radii = diameters / 2.0
        for k, centre in enumerate(centres):
            for axis_idx, axis in enumerate(["x", "y", "z"]):
                lo, hi = coord_ranges[axis]
                if centre[axis_idx] - radii[k] < lo - GEOMETRY_TOL or centre[axis_idx] + radii[k] > hi + GEOMETRY_TOL:
                    raise ValueError(
                        f"source_id={source_id}, subsource_id={k} crosses the configured {axis} boundary"
                    )
        for a in range(len(centres)):
            for b in range(a + 1, len(centres)):
                distance = float(np.linalg.norm(centres[a] - centres[b]))
                required = float(radii[a] + radii[b])
                if distance + GEOMETRY_TOL < required:
                    raise ValueError(
                        f"source_id={source_id} contains overlapping subsources {a} and {b}"
                    )
        source_records.append(record)

    # Every event emission point must lie in the subsource named on that row.
    dx = df["source_x"].to_numpy(dtype=np.float64) - df["subsource_center_x"].to_numpy(dtype=np.float64)
    dy = df["source_y"].to_numpy(dtype=np.float64) - df["subsource_center_y"].to_numpy(dtype=np.float64)
    dz = df["source_z"].to_numpy(dtype=np.float64) - df["subsource_center_z"].to_numpy(dtype=np.float64)
    distances = np.sqrt(dx * dx + dy * dy + dz * dz)
    radii = df["subsource_diameter"].to_numpy(dtype=np.float64) / 2.0
    outside = distances > radii + GEOMETRY_TOL
    if np.any(outside):
        raise ValueError(
            "Some event-specific source_x/y/z points lie outside their assigned subsource sphere. "
            f"Example rows: {np.flatnonzero(outside)[:10].tolist()}"
        )

    print(f"\nValidated {label}")
    print("  Event rows:", len(df))
    print("  Overall sources:", df["source_id"].nunique())
    print("  Subsources:", df[["source_id", "subsource_id"]].drop_duplicates().shape[0])
    print("  Number-of-subsources groups:", sorted(df["number_of_subsources"].unique().tolist()))
    print("  Integer diameters present:", sorted(df["subsource_diameter"].unique().tolist()))
    return df, source_records


# =========================================================
# MODEL-INPUT LEAKAGE GUARD
# =========================================================
def validate_model_feature_columns(feature_cols):
    """Ensure simulation ground truth never enters the neural-network input."""
    forbidden = {
        "source_id",
        "event_id",
        "number_of_subsources",
        "subsource_id",
        "subsource_center_x",
        "subsource_center_y",
        "subsource_center_z",
        "subsource_diameter",
        "source_x",
        "source_y",
        "source_z",
        "event_count",
        "event_fraction",
    }
    overlap = sorted(set(feature_cols) & forbidden)
    if overlap:
        raise ValueError(
            "Ground-truth columns cannot be used as model inputs: "
            f"{overlap}"
        )


# =========================================================
# DATA PIPELINE TRAIN
# =========================================================
def process_data_for_training(df, coord_ranges=None):
    if coord_ranges is None:
        coord_ranges = COORD_RANGES
    coord_ranges = normalize_coord_ranges(coord_ranges)

    feature_cols = [
        "scat_x", "scat_y", "scat_z",
        "e_energy",
        "absorb_x", "absorb_y", "absorb_z",
        "energy_abs",
    ]
    validate_model_feature_columns(feature_cols)
    source_cols = ["source_x", "source_y", "source_z"]

    df = df.copy()
    validate_required_columns(df)
    df["energy_abs"] = 1 - pd.to_numeric(df["e_energy"], errors="raise")
    df, validated_records = prepare_and_validate_multisource_dataframe(
        df, feature_cols=feature_cols, label="training CSV", coord_ranges=coord_ranges
    )
    record_by_id = {r["source_id"]: r for r in validated_records}

    raw_inputs = []
    raw_source_points = []
    raw_subsource_ids = []
    all_records = []
    observed_counts = []
    for source_id, g in df.groupby("source_id", sort=True):
        X = np.nan_to_num(g[feature_cols].to_numpy()).astype(np.float32)
        points = g[source_cols].to_numpy(dtype=np.float32)
        sub_ids = g["subsource_id"].to_numpy(dtype=np.int64)
        raw_inputs.append(X)
        raw_source_points.append(points)
        raw_subsource_ids.append(sub_ids)
        all_records.append(record_by_id[int(source_id)])
        observed_counts.append(int(len(g)))

    min_events, max_events = validate_random_event_range()
    eligible_mask = np.asarray([len(X) >= min_events for X in raw_inputs], dtype=bool)
    raw_inputs = [x for x, keep in zip(raw_inputs, eligible_mask) if keep]
    raw_source_points = [x for x, keep in zip(raw_source_points, eligible_mask) if keep]
    raw_subsource_ids = [x for x, keep in zip(raw_subsource_ids, eligible_mask) if keep]
    all_records = [x for x, keep in zip(all_records, eligible_mask) if keep]

    if len(all_records) < 4:
        raise ValueError("Need at least four eligible overall sources")

    labels = np.asarray([r["number_of_subsources"] for r in all_records], dtype=np.int32)
    first_stratify = choose_safe_count_stratify(labels, 0.30, "train vs temporary")

    (
        train_x_raw, temp_x_raw,
        train_points_raw, temp_points_raw,
        train_subids_raw, temp_subids_raw,
        train_records_raw, temp_records_raw,
    ) = train_test_split(
        raw_inputs,
        raw_source_points,
        raw_subsource_ids,
        all_records,
        test_size=0.30,
        shuffle=True,
        random_state=SEED,
        stratify=first_stratify,
    )

    temp_labels = np.asarray([r["number_of_subsources"] for r in temp_records_raw], dtype=np.int32)
    second_stratify = choose_safe_count_stratify(temp_labels, 0.50, "validation vs internal test")
    (
        val_x_raw, test_x_raw,
        val_points_raw, test_points_raw,
        val_subids_raw, test_subids_raw,
        val_records_raw, test_records_raw,
    ) = train_test_split(
        temp_x_raw,
        temp_points_raw,
        temp_subids_raw,
        temp_records_raw,
        test_size=0.50,
        shuffle=True,
        random_state=SEED,
        stratify=second_stratify,
    )

    train_x_sel, train_points, train_records, train_manifest = sample_variable_split(
        train_x_raw, train_points_raw, train_subids_raw, train_records_raw, "train",
        np.random.default_rng(SEED + 101), min_events, max_events
    )
    val_x_sel, val_points, val_records, val_manifest = sample_variable_split(
        val_x_raw, val_points_raw, val_subids_raw, val_records_raw, "validation",
        np.random.default_rng(SEED + 202), min_events, max_events
    )
    test_x_sel, test_points, test_records, test_manifest = sample_variable_split(
        test_x_raw, test_points_raw, test_subids_raw, test_records_raw, "internal_test",
        np.random.default_rng(SEED + 303), min_events, max_events
    )

    summarize_subsource_counts(train_records, "train", MIN_TRAIN_SOURCES_PER_COUNT_WARNING)
    summarize_subsource_counts(val_records, "validation")
    summarize_subsource_counts(test_records, "internal_test")

    scaler = StandardScaler().fit(np.concatenate(train_x_sel, axis=0))
    sequence_pad_length = max_events

    def transform_stack(seq_list):
        out = np.stack([
            transform_and_pad_sequence(X, scaler, sequence_pad_length, PAD_VALUE)
            for X in seq_list
        ]).astype(np.float32)
        return out.reshape(out.shape[0], out.shape[1], 1, out.shape[2])

    train_x = transform_stack(train_x_sel)
    val_x = transform_stack(val_x_sel)

    # Only train/validation tensors are needed by model.fit(). The previous
    # version also materialized the full internal-test 50x50x50 target tensor,
    # even though it was never used during training. For ~1,650 held-out
    # sources that is about 0.8 GB of unnecessary float32 memory. Avoiding it
    # reduces RAM pressure and helps prevent paging / slower host-to-GPU flow.
    train_y = batch_make_multi_subsource_volumes_5d(
        train_records, bins=50, sigma=TARGET_SPHERE_SIGMA, coord_ranges=coord_ranges
    )
    val_y = batch_make_multi_subsource_volumes_5d(
        val_records, bins=50, sigma=TARGET_SPHERE_SIGMA, coord_ranges=coord_ranges
    )

    manifest_df = pd.DataFrame(train_manifest + val_manifest + test_manifest)
    manifest_path = os.path.join(output_folder, "event_selection_manifest_train_validation_test.csv")
    manifest_df.to_csv(manifest_path, index=False)

    # Strong leakage check by source ID.
    train_ids = {r["source_id"] for r in train_records}
    val_ids = {r["source_id"] for r in val_records}
    test_ids = {r["source_id"] for r in test_records}
    assert not (train_ids & val_ids or train_ids & test_ids or val_ids & test_ids)

    split_info = (
        f"Experiment case: {case_label}\n"
        f"Coordinate ranges: {coord_ranges}\n"
        f"Grouping entity: one overall source_id containing {MIN_SUBSOURCES}-{MAX_SUBSOURCES} allowed subsources\n"
        "Prediction target: physical subspheres weighted by observed selected-event fractions\n"
        f"Target sigma: {TARGET_SPHERE_SIGMA:g}\n"
        "Training loss: JSD + projection SSIM + marginal CDF + spatial extent\n"
        "Event encoder: BiLSTM + masked mean/std/max learned-event statistics\n"
        "Split: 70% train / 15% validation / 15% internal test by source_id\n"
        "Stratification: number_of_subsources when mathematically possible\n"
        f"Train overall sources: {len(train_records)}\n"
        f"Validation overall sources: {len(val_records)}\n"
        f"Internal test overall sources: {len(test_records)}\n"
        "Verified source overlap across splits: zero\n"
    )
    print("\n" + split_info)
    with open(os.path.join(output_folder, "dataset_split_info.txt"), "w") as f:
        f.write(split_info)

    plot_target_density(np.concatenate(train_points, axis=0), "train", coord_ranges)
    plot_target_density(np.concatenate(val_points, axis=0), "val", coord_ranges)
    plot_target_density(np.concatenate(test_points, axis=0), "test", coord_ranges)

    print("Shapes -> X (train/val):", train_x.shape, val_x.shape)
    print("Shapes -> Y (train/val):", train_y.shape, val_y.shape)
    print(
        "Dense target RAM (train + val):",
        f"{(train_y.nbytes + val_y.nbytes) / (1024 ** 3):.2f} GiB"
    )

    return (
        train_x, train_y, val_x, val_y,
        train_records, val_records, test_records,
        scaler, feature_cols, sequence_pad_length,
    )


