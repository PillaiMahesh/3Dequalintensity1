def train_only(df):
    coord_ranges = normalize_coord_ranges(COORD_RANGES)
    (
        train_x, train_y, val_x, val_y,
        train_records, val_records, test_records,
        scaler, feature_cols, sequence_pad_length,
    ) = process_data_for_training(df, coord_ranges=coord_ranges)

    # Release temporary Python/NumPy objects that are no longer needed before
    # the large 3-D training graph starts allocating GPU/CPU buffers.
    gc.collect()

    save_artifacts(
        scaler, train_records, val_records, test_records,
        feature_cols, sequence_pad_length, coord_ranges=coord_ranges
    )

    model = create_volume_model(
        input_shape=(None, 1, train_x.shape[-1]),
        lr=3e-4,
        temperature=1.0,
        tv_lambda=0.0,
        jsd_weight=JSD_LOSS_WEIGHT,
        ssim_weight=PROJECTION_SSIM_LOSS_WEIGHT,
        cdf_weight=MARGINAL_CDF_LOSS_WEIGHT,
        extent_weight=EXTENT_LOSS_WEIGHT,
        ssim_max_val=1.0,
    )
    model.summary(print_fn=lambda x: print(x))

    early_stopping = callbacks.EarlyStopping(
        monitor="val_loss", patience=40, min_delta=1e-3, restore_best_weights=True
    )
    ckpt_best = callbacks.ModelCheckpoint(TRAIN_MODEL_PATH, monitor="val_loss", save_best_only=True)
    reduce_lr = callbacks.ReduceLROnPlateau(
        monitor="val_loss", factor=0.5, patience=10, min_lr=1e-6, verbose=1
    )
    tb = callbacks.TensorBoard(log_dir=os.path.join(output_folder, "tb"), update_freq="epoch")

    print("\nTraining performance configuration:")
    print("  GPU devices:", tf.config.list_physical_devices("GPU"))
    print("  Batch size:", TRAIN_BATCH_SIZE)
    print("  Steps per execution:", STEPS_PER_EXECUTION)
    print("  Expensive per-batch metrics:", COMPUTE_EXPENSIVE_TRAINING_METRICS)
    print("  Strict determinism:", STRICT_DETERMINISM)
    if not tf.config.list_physical_devices("GPU"):
        print(
            "  WARNING: No GPU is visible to TensorFlow. Training this 3-D model "
            "on CPU will be much slower. In Kaggle, enable a GPU accelerator."
        )

    history = model.fit(
        train_x,
        train_y,
        epochs=TRAIN_EPOCHS,
        batch_size=TRAIN_BATCH_SIZE,
        validation_data=(val_x, val_y),
        callbacks=[early_stopping, ckpt_best, reduce_lr, tb],
        verbose=2,
    )
    plot_training_history(history)
    with open(os.path.join(output_folder, "training_history.json"), "w") as f:
        json.dump({k: [float(x) for x in v] for k, v in history.history.items()}, f, indent=2)
    print("Training complete. Best model saved to:", TRAIN_MODEL_PATH)


