    ax.legend([bars, line], ["# Sources", "Mean matched subsource error"], loc="upper center", ncol=2)
    fig.suptitle("Localization Performance vs. Number of Subsources", fontsize=16, fontweight="bold")

    table_ax = fig.add_axes([0.04, 0.08, 0.92, 0.34])
    table_ax.axis("off")
    table_rows = []
    for row in source_stats_df.itertuples(index=False):
        table_rows.append([
            row.subsource_count_label,
            str(int(row.number_of_sources)),
            _format_summary_value(row.mean_global_centroid_error, 2),
            _format_summary_value(row.mean_matched_subsource_error, 2),
            _format_summary_value(row.std_matched_subsource_error, 2),
            _format_summary_value(row.mean_full_3d_ssim, 4),
