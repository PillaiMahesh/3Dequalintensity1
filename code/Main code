    os.makedirs(summary_dir, exist_ok=True)

    df_test = pd.read_csv(test_csv_path)
    test_min_events = int(meta.get("min_events_per_source", MIN_EVENTS_PER_SOURCE))
    test_max_events = int(meta.get("max_events_per_source", MAX_EVENTS_PER_SOURCE))
    sequence_pad_length = int(meta.get("sequence_pad_length", test_max_events))

    test_x, true_source_points, source_records, event_manifest, _ = build_test_from_csv(
        df_test,
        requested_records,
        scaler,
        feature_cols,
        min_events_per_source=test_min_events,
        max_events_per_source=test_max_events,
        sequence_pad_length=sequence_pad_length,
        manifest_output_dir=shared_dir,
        coord_ranges=coord_ranges,
    )

    print("Test tensor shape:", test_x.shape)
    pred_maps = model.predict(test_x, verbose=1).astype(np.float32)
    pred_volumes = np.squeeze(pred_maps, axis=-1)
    # Build each GT volume once inside the evaluation loop. This avoids
    # keeping a second 50^3 array for every test source in RAM unless NPZ
    # export was explicitly requested.
    gt_volumes_for_save = [] if SAVE_ALL_PREDICTIONS_NPZ else None

    source_rows = []
    matched_rows = []
    true_all = []
    pred_all = []

    for i, (record, pred_volume) in enumerate(zip(source_records, pred_volumes)):
        gt_volume, component_volumes = make_multi_subsource_volume(
            record, bins=50, sigma=artifact_sigma, normalize="sum",
            coord_ranges=coord_ranges, return_components=True
        )
        if gt_volumes_for_save is not None:
            gt_volumes_for_save.append(gt_volume.astype(np.float32))
        record = normalize_source_record(record)
        n = record["number_of_subsources"]
        true_centroid = true_event_cloud_centroid(true_source_points[i])
        pred_centroid = np.asarray(probability_center_of_mass(pred_volume, 50, coord_ranges), dtype=np.float64)
        global_error = float(np.linalg.norm(pred_centroid - true_centroid))

        pred_peaks, pred_probs = extract_predicted_subsource_centres(
            pred_volume, n, bins=50, coord_ranges=coord_ranges,
            random_seed=SEED + int(record["source_id"])
        )
        rows = match_predicted_centres_to_true_subsources(record, pred_peaks, pred_probs)
        event_fraction_by_id = {
            int(s["subsource_id"]): float(s.get("event_fraction", np.nan))
            for s in record["subsources"]
        }
        # Add observed event fraction and diameter-local SSIM to each matched true subsource.
        for row in rows:
            row["observed_event_fraction"] = event_fraction_by_id.get(
                int(row["subsource_id"]), np.nan
            )
            sub_idx = next(
                idx for idx, s in enumerate(record["subsources"])
                if s["subsource_id"] == row["subsource_id"]
            )
            row["sample_index"] = int(i)
            row["local_3d_ssim"] = compute_component_local_ssim_from_arrays(
                gt_volume, component_volumes[sub_idx], pred_volume, margin=3
            )
            matched_rows.append(row)
            true_all.append([row["true_x"], row["true_y"], row["true_z"]])
            pred_all.append([row["pred_x"], row["pred_y"], row["pred_z"]])

        matched_errors = np.asarray([r["euclidean_distance"] for r in rows], dtype=np.float64)
        local_ssims = np.asarray([r["local_3d_ssim"] for r in rows], dtype=np.float64)
        full_ssim = compute_ssim_3d(gt_volume, pred_volume)

        iz, iy, ix = np.unravel_index(np.argmax(pred_volume), pred_volume.shape)
        argmax_x, argmax_y, argmax_z = idx_to_coord(ix, iy, iz, 50, coord_ranges)

        source_rows.append({
            "sample_index": int(i),
            "source_id": int(record["source_id"]),
            "number_of_subsources": int(n),
            "observed_subsource_event_fractions": ";".join(
                f"{float(w):.8f}" for w in source_record_event_fractions(record)
            ),
            "true_global_centroid_x": float(true_centroid[0]),
            "true_global_centroid_y": float(true_centroid[1]),
            "true_global_centroid_z": float(true_centroid[2]),
            "pred_global_centroid_x": float(pred_centroid[0]),
            "pred_global_centroid_y": float(pred_centroid[1]),
            "pred_global_centroid_z": float(pred_centroid[2]),
            "global_centroid_error": global_error,
            "mean_matched_subsource_error": float(matched_errors.mean()),
            "max_matched_subsource_error": float(matched_errors.max()),
            "rmse_matched_subsource_error": float(np.sqrt(np.mean(matched_errors ** 2))),
            "sample_full_3d_ssim": float(full_ssim),
            "mean_local_component_ssim": float(np.nanmean(local_ssims)) if np.isfinite(local_ssims).any() else np.nan,
            "selected_events": int(event_manifest.iloc[i]["selected_events"]),
            "available_events": int(event_manifest.iloc[i]["available_events"]),
            "argmax_x": float(argmax_x),
            "argmax_y": float(argmax_y),
            "argmax_z": float(argmax_z),
            "target_sigma": float(artifact_sigma),
        })

    source_df = pd.DataFrame(source_rows)
    matched_df = pd.DataFrame(matched_rows)

    source_path = os.path.join(shared_dir, "overall_source_predictions.csv")
    matched_path = os.path.join(shared_dir, "matched_subsource_predictions.csv")
    source_df.to_csv(source_path, index=False)
    matched_df.to_csv(matched_path, index=False)
    print("Saved overall-source predictions:", source_path)
    print("Saved matched-subsource predictions:", matched_path)

    if len(matched_df):
        plot_hist_with_moments(
            matched_df["euclidean_distance"].to_numpy(),
            "Matched Subsource Localization Error",
            "Euclidean distance (mm)",
            os.path.join(shared_dir, "matched_subsource_euclidean_error_histogram.png"),
        )
        plot_pred_vs_true(
            np.asarray(true_all, dtype=np.float32),
            np.asarray(pred_all, dtype=np.float32),
            tag="matched_subsources",
            coord_ranges=coord_ranges,
            output_dir=shared_dir,
        )

    plot_hist_with_moments(
        source_df["global_centroid_error"].to_numpy(),
        "Overall-Source Centroid Error",
        "Euclidean distance (mm)",
        os.path.join(shared_dir, "overall_source_centroid_error_histogram.png"),
    )

    save_count_grouped_results(
        source_records, true_source_points, pred_volumes, source_df,
        coord_ranges, artifact_sigma
    )
    save_performance_summaries(source_df, matched_df, summary_dir)

    if SAVE_ALL_PREDICTIONS_NPZ:
        np.savez_compressed(
            os.path.join(shared_dir, "pred_volumes_all.npz"),
            pred_volumes=pred_volumes.astype(np.float32),
            gt_volumes=np.asarray(gt_volumes_for_save, dtype=np.float32),
            source_ids=np.asarray([r["source_id"] for r in source_records], dtype=np.int64),
            number_of_subsources=np.asarray([r["number_of_subsources"] for r in source_records], dtype=np.int32),
        )

    summary_path = os.path.join(shared_dir, "evaluation_summary_test_mode.txt")
    with open(summary_path, "w") as f:
        f.write("=== Evaluation Summary: Multi-Subsource 3D Reconstruction ===\n\n")
        f.write(f"Test CSV: {test_csv_path}\n")
        f.write(f"Artifacts: {artifact_folder}\n")
        f.write(f"Overall sources tested: {len(source_df)}\n")
        f.write(f"True subsources evaluated: {len(matched_df)}\n")
        f.write(f"Subsource counts present: {sorted(source_df['number_of_subsources'].unique().tolist())}\n")
        f.write("Target representation: physical subspheres weighted by observed event fractions\n")
        f.write(f"Target sigma: {artifact_sigma:g}\n\n")
        f.write(f"Mean matched subsource localization error: {matched_df['euclidean_distance'].mean():.6f} mm\n")
        f.write(f"RMSE matched subsource localization error: {np.sqrt(np.mean(matched_df['euclidean_distance'].to_numpy() ** 2)):.6f} mm\n")
        f.write(f"Mean overall-source centroid error: {source_df['global_centroid_error'].mean():.6f} mm\n")
        if "sample_full_3d_ssim" in source_df:
            f.write(f"Overall full-volume 3D SSIM: {source_df['sample_full_3d_ssim'].mean():.6f}\n")
        if "local_3d_ssim" in matched_df:
            f.write(f"Mean local component 3D SSIM: {matched_df['local_3d_ssim'].mean():.6f}\n")
        f.write("\nEvaluation component matching uses the known true subsource count only to obtain the same number of KMeans component centres for metric calculation. Ground-truth event fractions are used only for target/evaluation construction. The network itself receives only detector-event features.\n")
    print("Saved test summary:", summary_path)
    display_first_saved_result()


