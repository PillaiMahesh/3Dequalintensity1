def validate_random_event_range(min_events=None, max_events=None):
    if min_events is None:
        min_events = MIN_EVENTS_PER_SOURCE
    if max_events is None:
        max_events = MAX_EVENTS_PER_SOURCE
    min_events = int(min_events)
    max_events = int(max_events)
    if min_events <= 0:
        raise ValueError("MIN_EVENTS_PER_SOURCE must be positive")
    if max_events < min_events:
        raise ValueError("MAX_EVENTS_PER_SOURCE must be >= MIN_EVENTS_PER_SOURCE")
    return min_events, max_events



def pad_event_count(X, target_count, pad_value=PAD_VALUE):
    n = X.shape[0]
    if n > target_count:
        raise ValueError(f"Cannot pad n={n} to target_count={target_count}")
    if n == target_count:
        return X.astype(np.float32)
    pad = np.full((target_count - n, X.shape[1]), pad_value, dtype=np.float32)
    return np.vstack([X.astype(np.float32), pad]).astype(np.float32)


def transform_and_pad_sequence(X_raw, scaler, target_count, pad_value=PAD_VALUE):
    X_scaled = scaler.transform(np.nan_to_num(X_raw)).astype(np.float32)
    return pad_event_count(X_scaled, target_count, pad_value)


