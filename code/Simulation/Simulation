# RUN THE PROGRAM
# =========================================================

if __name__ == "__main__":

    noOfSourcePerImage = (
        param.noOfSources
    )

    noOfEventsPerSource = (
        param.noOfEvents
    )

    generated_dataframe, generated_csv_path = (
        genSimEvents(
            noOfSources=noOfSourcePerImage,
